# TTY Program for STerM.
# Open Source TTY Code Example.
# File Saving Mode
# Written in Starlit 5.1 Pythonic Style.

COMPORT = ["COM3"]                   # Please change to exact COM Port.

main:
    COM[0].Open(115200)                    # Default : 115200baud, no parity, 8bit, 1bit stop
    st = str
    logFile = FILE_Setup("log.txt", "ab", "\r\n")
    while 1:
        if *COM[0]:
            re = COM[0].Read(st)
            Print1 st
            logFile << st
        if kbhit():
            key = getch()
            if key == 224:
                key = getch()
                when key:
                    case 72:
                        COM[0] << f"{0x1B:c}[A"
                    case 80:
                        COM[0] << f"{0x1B:c}[B"
                    case 77:
                        COM[0] << f"{0x1B:c}[C"
                    case 75:
                        COM[0] << f"{0x1B:c}[D"
            elif key == 0x08:
                COM[0] << f"{127:c}"
            else:
                COM[0] << f"{key:c}"